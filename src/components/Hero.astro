---
import '../global.css';

const container = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: { staggerChildren: 0.2, delayChildren: 0.1 },
  },
};

const item = {
  hidden: { opacity: 0, y: 20 },
  visible: { opacity: 1, y: 0, transition: { duration: 0.8, ease: 'easeOut' } },
};
---

<section class="relative h-screen flex items-center justify-center overflow-hidden bg-soft-bg">
  <div class="absolute inset-0 -z-10">
    <div
      style={{
        position: 'absolute',
        top: '5rem',
        left: '2.5rem',
        width: '18rem',
        height: '18rem',
        backgroundColor: 'var(--color-heritage-gold)',
        borderRadius: '50%',
        filter: 'blur(3rem)',
        opacity: 0.1,
        animation: 'float 8s ease-in-out infinite',
      }}
    />
    <div
      style={{
        position: 'absolute',
        bottom: '5rem',
        right: '2.5rem',
        width: '18rem',
        height: '18rem',
        backgroundColor: 'var(--color-heritage-clay)',
        borderRadius: '50%',
        filter: 'blur(3rem)',
        opacity: 0.1,
        animation: 'float 10s ease-in-out infinite reverse',
      }}
    />
  </div>

  <div
    class="max-w-4xl mx-auto px-6 text-center"
    style={{ animation: 'fadeIn 1s ease-out' }}
  >
    <h1
      style={{ fontFamily: 'var(--font-serif)', fontSize: '4rem', fontWeight: '300', lineHeight: '1.1', marginBottom: '1.5rem' }}
    >
      Madhulika's
    </h1>

    <p
      style={{ fontSize: '1.125rem', lineHeight: '1.75', marginBottom: '2rem', color: 'rgba(26, 26, 26, 0.7)', maxWidth: '32rem', margin: '0 auto 2rem' }}
    >
      Heritage Bengali aesthetics meets peak modernity. Discover hand-crafted fabrics that tell stories of tradition and contemporary style.
    </p>

    <div style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem', justifyContent: 'center', alignItems: 'center' }}>
      <a
        href="#collections"
        style={{
          padding: '0.75rem 2rem',
          backgroundColor: 'var(--color-heritage-gold)',
          color: 'white',
          fontWeight: '500',
          borderRadius: '0',
          textDecoration: 'none',
          transition: 'background-color 0.3s',
        }}
        onmouseover="this.style.backgroundColor='var(--color-heritage-clay)'"
        onmouseout="this.style.backgroundColor='var(--color-heritage-gold)'"
      >
        Explore Collections
      </a>
      <a
        href="#contact"
        style={{
          padding: '0.75rem 2rem',
          border: '2px solid var(--color-heritage-gold)',
          color: 'var(--color-heritage-gold)',
          fontWeight: '500',
          borderRadius: '0',
          textDecoration: 'none',
          transition: 'background-color 0.3s',
        }}
        onmouseover="this.style.backgroundColor='rgba(194, 157, 89, 0.05)'"
        onmouseout="this.style.backgroundColor='transparent'"
      >
        Get in Touch
      </a>
    </div>

    <div style={{ marginTop: '4rem', fontSize: '0.875rem', color: 'rgba(26, 26, 26, 0.5)' }}>
      Scroll to explore
    </div>
  </div>

  <style is:global>
    @keyframes float {
      0%, 100% { transform: translateY(0) translateX(0); }
      50% { transform: translateY(50px) translateX(30px); }
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</section>
